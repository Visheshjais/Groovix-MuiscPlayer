# ══════════════════════════════════════════════
#  GROOVIX — Backend Environment Variables
#  Copy this file to .env and fill in your keys
# ══════════════════════════════════════════════

# Primary YouTube API key
YOUTUBE_API_KEY=your_first_key_here

# Additional keys for rotation (add as many as you want up to 10)
# When YOUTUBE_API_KEY hits quota, it auto-switches to KEY_2, then KEY_3 etc.
YOUTUBE_API_KEY_2=your_second_key_here
YOUTUBE_API_KEY_3=your_third_key_here
# YOUTUBE_API_KEY_4=your_fourth_key_here
# YOUTUBE_API_KEY_5=your_fifth_key_here

PORT=3001
